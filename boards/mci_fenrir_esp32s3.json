{
    "build": {
      "arduino": {
        "ldscript": "esp32s3_out.ld",
        "memory_type": "qio_qspi"
      },
      "core": "esp32",
      "extra_flags": [
        "-DARDUINO_MCI_FENRIR_ESP32S3",
        "-DARDUINO_ARCH_ESP32",
        "-DCONFIG_IDF_TARGET_ESP32S3",
        "-DESP32S3",
        "-DARDUINO_USB_CDC_ON_BOOT=1",
        "-DESP_IDF_VERSION_MAJOR=5",
        "-DESP_IDF_VERSION_MINOR=1",
        "-DESP_IDF_VERSION_PATCH=0"
      ],
      "f_cpu": "240000000L",
      "f_flash": "80000000L",
      "flash_mode": "qio",
      "hwids": [
        [
          "0x239A",
          "0x80AB"
        ]
      ],
      "mcu": "esp32s3",
      "variants_dir": "boards/variants",
      "variant": "mci_fenrir_esp32s3"
    },
    "connectivity": [
      "bluetooth",
      "wifi"
    ],
    "debug": {
      "openocd_target": "esp32s3.cfg"
    },
    "frameworks": [
      "arduino",
      "espidf"
    ],
    "name": "MCI Fenrir ESP32S3",
    "upload": {
      "flash_size": "4MB",
      "maximum_ram_size": 327680,
      "maximum_size": 4194304,
      "require_upload_port": true,
      "speed": 921600
    },
    "url": "https://github.com/MCI-Fenrir",
    "vendor": "MCI"
}

